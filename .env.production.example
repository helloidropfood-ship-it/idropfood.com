# iDropFood Production Environment Variables Template
# Copy this file to .env.production or configure these variables in your hosting provider (e.g., Vercel)
# DO NOT commit real secrets/keys to your repository.

# Public Supabase Client URL
VITE_SUPABASE_URL=

# Public Supabase Anon/Publishable API Key
VITE_SUPABASE_ANON_KEY=

# Enforce real Supabase provider (keep true for production)
VITE_USE_SUPABASE=true

# Note: NEVER expose SUPABASE_SERVICE_ROLE_KEY or any private keys in frontend files or VITE_ prefixed variables.
